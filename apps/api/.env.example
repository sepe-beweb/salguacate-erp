# Local development. Never commit .env or real credentials.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AI_ENABLED=false

# SQLite remains the default. Production SQLite requires a persistent path.
# DATABASE_DRIVER=sqlite
# SQLITE_DATABASE_PATH=
# UPLOADS_DIR=
# Private persistent directory, separate from public uploads. SQLite only.
# Defaults to documents/ next to the database. Include it in offline backups.
# DOCUMENTS_DIR=

# Opt-in Turso runtime, only after a separate explicit remote bootstrap.
# Startup validates schema/owner; it never initializes or migrates remote data.
# DATABASE_DRIVER=libsql
# TURSO_DATABASE_URL=
# TURSO_DATABASE_HOST=
# TURSO_AUTH_TOKEN=
# Do not combine with SQLITE_DATABASE_PATH. Remote production requires Cloudinary.

# Railway Node service only: private documents on an actual persistent Linux mount.
# Create a volume mounted at /data. Railway supplies RAILWAY_VOLUME_MOUNT_PATH.
# Never set that variable manually to an ordinary directory or use DOCUMENTS_DIR.
# DOCUMENT_STORAGE=railway-volume
# SERVE_WEB=true
# Build from repository root; public frontend VITE_API_URL=/ uses the same origin.
# CORS_ORIGINS must be the exact generated HTTPS domain. See docs/deployment-railway.md.

# Explicit remote image storage; no fallback to the Render filesystem.
# IMAGE_STORAGE=cloudinary
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Prefer the explicit --database/--name/--pin-stdin mode for a new installation.
# Legacy mode only: set for first bootstrap against an empty user table; remove afterwards.
# BOOTSTRAP_OWNER_NAME=
# BOOTSTRAP_OWNER_PIN=

# Only after explicit approval to send content to the external AI provider:
# GEMINI_API_KEY=
