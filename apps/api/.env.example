# Local development. Never commit .env or real credentials.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AI_ENABLED=false

# Optional absolute paths; production requires a persistent database path.
# SQLITE_DATABASE_PATH=
# UPLOADS_DIR=

# Set ONLY for first bootstrap against an empty database; remove afterwards.
# BOOTSTRAP_OWNER_NAME=
# BOOTSTRAP_OWNER_PIN=

# Only after explicit approval to send content to the external AI provider:
# GEMINI_API_KEY=
