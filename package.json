{
  "name": "salguacate-platform",
  "private": true,
  "workspaces": [
    "apps/api"
  ],
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.23.2 <23",
    "npm": ">=10 <12"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "start": "node apps/api/server.js",
    "dev": "npm run dev:erp",
    "dev:erp": "vite",
    "dev:api": "npm run start --workspace apps/api",
    "bootstrap": "node apps/api/scripts/bootstrap-owner.js",
    "bootstrap:remote": "node apps/api/scripts/bootstrap-remote-owner.js",
    "recovery": "node scripts/recovery.cjs",
    "probe:turso": "node apps/api/scripts/turso-probe.js",
    "build": "npm run build:erp",
    "build:erp": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "npm run lint && npm test && npm run build:erp",
    "test:e2e": "node scripts/run-e2e.cjs",
    "test:e2e:production": "node scripts/run-e2e.cjs --config playwright.production.config.ts",
    "test:e2e:railway": "node scripts/run-e2e.cjs --config playwright.railway.config.ts",
    "build:android": "npm run build:erp && node -e \"fs.cpSync('dist/erp', 'apps/android/app/src/main/assets/www', {recursive:true, force:true})\""
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^11.1.7",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.378.0",
    "pdfjs-dist": "6.3.289",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^2.12.7",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitejs/plugin-react": "6.0.5",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.2.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
